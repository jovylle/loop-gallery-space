# Firebase client config is committed in shared/firebase.config.ts (public keys).
# Only set these if you need to override locally (optional):
# NUXT_PUBLIC_FIREBASE_API_KEY=
# NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NUXT_PUBLIC_FIREBASE_PROJECT_ID=
# NUXT_PUBLIC_FIREBASE_APP_ID=

# R2 presigned uploads (S3 API credentials from Cloudflare dashboard)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public URL for media (R2 custom domain or r2.dev)
NUXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Site URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000
