# Play Console → App content → Privacy policy URL:
# https://loopgallery.a-u.us/privacy

# Android Google Sign-In (required for in-app sign-in):
# 1. Firebase Console → Project settings → Your apps → Add Android app
#    Package: us.a_u.loopgallery.app
# 2. Download google-services.json → mobile/android/app/google-services.json
# 3. Add SHA-1 (debug): keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android
# 4. Add release SHA-1 from Play App Signing to Firebase + public/.well-known/assetlinks.json

# Point the WebView at a different host (default: https://loopgallery.a-u.us)
# CAPACITOR_SERVER_URL=https://loopgallery.a-u.us

# Android emulator → dev machine (run `npm run dev` at repo root first)
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000
