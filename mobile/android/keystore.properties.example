# Copy to keystore.properties (gitignored). NEVER commit the real file or .keystore.
#
# Play Console uses TWO different certificates — do not confuse them:
#
#   UPLOAD KEY (SHA-1)
#     → Signs the .aab BEFORE you upload to Play.
#     → Play Console → App integrity → Upload key certificate → SHA-1
#     → LoopGallery closed test 1.0 expects:
#       3E:4E:B5:FB:14:E7:F9:EB:FA:E6:93:04:E9:B7:4D:E7:0C:6E:BB:BF
#     → Find matching keystore: bash mobile/scripts/find-upload-keystore.sh ~/path/to/search
#
#   APP SIGNING KEY (SHA-256)
#     → What users actually install after Google re-signs your bundle.
#     → Play Console → App integrity → App signing key certificate
#     → public/.well-known/assetlinks.json uses this SHA-256 (NOT the upload key).
#     → ~/fore/debug.keystore (SHA-1 D7:B6:5F:…) matches assetlinks — wrong cert for uploads.
#
# Create a new upload keystore ONLY for a brand-new Play listing (or after Google approves
# an upload key reset). Updates must use the same upload key as the first release.
#
#   keytool -genkey -v -keystore loopgallery-release.keystore -alias loopgallery \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../loopgallery-release.keystore
storePassword=your-store-password
keyAlias=loopgallery
keyPassword=your-key-password
