{
  "name": "loop-gallery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "deploy": "wrangler deploy",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:migrate": "wrangler d1 migrations apply loopgallery-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply loopgallery-db --remote",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "mobile:install": "npm install --prefix mobile",
    "mobile:sync": "npm run sync --prefix mobile",
    "mobile:android": "npm run open:android --prefix mobile",
    "mobile:assets": "npm run assets:generate --prefix mobile",
    "mobile:release": "bash mobile/scripts/play-release.sh",
    "mobile:apk": "bash mobile/scripts/build-apk.sh",
    "mobile:native-auth": "bash mobile/scripts/setup-native-auth.sh",
    "mobile:find-keystore": "bash mobile/scripts/find-upload-keystore.sh",
    "mobile:check-signing": "bash mobile/scripts/check-signing.sh"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.2.0",
    "@capacitor/status-bar": "^7.0.1",
    "@vueuse/core": "^12.5.0",
    "aws4fetch": "^1.0.20",
    "firebase": "^11.2.0",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "vue-draggable-plus": "^0.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@nuxt/eslint": "^1.0.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/tailwindcss": "^6.13.1",
    "nuxt": "^3.15.4",
    "typescript": "^5.7.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "wrangler": "^3.109.2"
  }
}
